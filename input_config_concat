[PATH]
exp_dir = ./exp
; data_dir = '/home/aiworker2/thang/climateNet'
data_dir = '../data/climatenet'
pretrained_name = 'best_model.pth'
project_name = climate-sam-new
run_name = ADAPTATION_OPTIMAL_1

[BATCH CONFIG]
num_workers = 4
gradient_accumulation_steps = 4
train_bs = 32
val_bs = 4
; weight_decay = 1e-4
lr = 1e-3

[PHASE]
phase = 1
augmented = False
positive_point_num = 2
negative_point_num = 2
prompt_type = point

[MODEL CONFIG]
; sam_type = vit_l
sam_type = vit_b
; cat_type = cat-a
fuse_channels = 128

[PROMPTS]
prompt_enlarge_ratio = 0.2

[TRAINING LOOP]
; shot_num = 1
max_epoch_num = 50
valid_per_epochs = 5

[LOSS CONFIG FOCAL]
gamma_ar = 2
alpha_ar = 0.75

gamma_tc = 5
alpha_tc = 0.996

[LOSS CONFIG TVERSKY]
alpha_ar_tversky = 0.3
beta_ar_tversky = 0.7

alpha_tc_tversky = 0.3
beta_tc_tversky = 0.7

[LOSS Weights]
focal_weight = 1
tversky_weight = 1.0
bce_weight = 0
[LOSS CONFIG COMMON]
bce_weight_tc = 1
bce_weight_ar = 1

[IMAGE ENCODER CONFIG]
image_encoder_mlp_ratio = 0.5

[DEBUGGING]
load_pretrained = False
wandb = True
save_model = False
debugging = False

[VANILLA SAM CONFIG]
data_type = 'ar'